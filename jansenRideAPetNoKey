local function setMinimized(v)
	minimized = v
	pulseBlur()
	MinBtn.Text = v and "+" or "–"
	if v then
		tween(Main, 0.35, { Size = UDim2.fromOffset(WIDTH, HEAD_H) }, Enum.EasingStyle.Quint)
		task.delay(0.2, function() if minimized then Body.Visible = false end end)
	else
		Body.Visible = true
		tween(Main, 0.4, { Size = UDim2.fromOffset(WIDTH, FULL_H) }, Enum.EasingStyle.Back)
	end
	updateBlur()
end
MinBtn.MouseButton1Click:Connect(function() setMinimized(not minimized) end)

CloseBtn.MouseButton1Click:Connect(function()
	stopAll()
	if SAVER_ON or BLACK_SCREEN or lowGfxApplied then setSaver(false) end
	stopFx()
	tween(Blur, 0.2, { Size = 0 })
	tween(MainScale, 0.25, { Scale = 0.8 }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
	tween(Main, 0.25, { BackgroundTransparency = 1 })
	task.wait(0.3)
	Blur:Destroy()
	BlackGui:Destroy()
	Gui:Destroy()
end)

