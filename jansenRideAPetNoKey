		end
		local ok, res = pcall(f, {
			Url = url, Method = method, Headers = { ["Content-Type"] = "application/json" }, Body = body,
		})
		if not ok or not res then
			lastIssue = "request failed (blocked or no internet)"
			return nil
		end
		local code = res.StatusCode or 200
		if code < 300 then return res.Body or "" end
		if code == 401 or code == 403 then
			lastIssue = "permission denied - publish the database rules"
		else
			lastIssue = "HTTP " .. tostring(code)
		end
		return nil
	end

	local connecting = true
	local lastReason = nil
	local function setOnline(n, reason, total)
		local txt, col
		if n then
			txt, col = ("👥 %d online"):format(n), GOOD
			if total then txt = txt .. (" • %d total"):format(total) end
		elseif not presenceBase then
			txt, col = "👥 not set up", SUB
		elseif connecting then
			txt, col = "👥 connecting...", SUB
		else
			txt, col = "👥 offline", WARN
		end
		OnlineLabel.Text, OnlineLabel.TextColor3 = txt, col
		HeaderSub.Text, HeaderSub.TextColor3 = txt, (n and GOOD) or SUB
		if reason and reason ~= lastReason then
			lastReason = reason
			logLine("online counter: " .. reason)
			setStatus("👥 " .. reason)
		end
	end

	local registered = false
	local function presenceTick()
		if not presenceBase then return end
		local stamp = [[{"t":{".sv":"timestamp"}}]]

		-- 1) heartbeat + count who is online right now
		local put = httpReq("PUT", presenceBase .. "/janrepublic_online/" .. USER_ID .. ".json", stamp)
		if not put then setOnline(nil, lastIssue) return end
		local body = httpReq("GET", presenceBase .. "/janrepublic_online.json")
		if not body then setOnline(nil, lastIssue) return end
		if body == "" or body == "null" then setOnline(nil, "empty answer from the database") return end
		local ok, data = pcall(function() return HttpService:JSONDecode(body) end)
		if not ok or type(data) ~= "table" then setOnline(nil, "unreadable answer from the database") return end

		local mine = data[USER_ID]
		local now = type(mine) == "table" and mine.t
		if not now then setOnline(nil, "database did not return our entry") return end

		local count, removed = 0, 0
		for id, v in pairs(data) do
			local t = type(v) == "table" and v.t
			if t then
				if now - t <= 90000 then
					count += 1
				elseif now - t > 600000 and removed < 5 then
					removed += 1
					httpReq("DELETE", presenceBase .. "/janrepublic_online/" .. id .. ".json")
				end
			end
		end

		-- 2) total unique users (everyone who ever ran the script)
		if not registered then
			if httpReq("PUT", presenceBase .. "/janrepublic_users/" .. USER_ID .. ".json", stamp) then
				registered = true
			end
		end
		local total
		local ub = httpReq("GET", presenceBase .. "/janrepublic_users.json?shallow=true")
		if ub then
			if ub == "" or ub == "null" then
				total = 0
			else
				local ok2, d2 = pcall(function() return HttpService:JSONDecode(ub) end)
				if ok2 and type(d2) == "table" then
					total = 0
					for _ in pairs(d2) do total += 1 end
				end
			end
		end

		connecting = false
		lastReason = nil
		setOnline(count, (not total) and ("total counter: " .. lastIssue .. " (janrepublic_users)") or nil, total)
	end

	PresenceStop = function()
		if presenceBase then
			task.spawn(httpReq, "DELETE", presenceBase .. "/janrepublic_online/" .. USER_ID .. ".json")
		end
	end

	setOnline(nil)
	task.spawn(function()
		while Gui.Parent do
			local ok = pcall(presenceTick)
			if connecting and presenceBase then
				connecting = false
				if not ok then setOnline(nil, "counter error") end
			end
			for _ = 1, 30 do
				if not Gui.Parent then break end
				task.wait(1)
			end
		end
	end)
end

