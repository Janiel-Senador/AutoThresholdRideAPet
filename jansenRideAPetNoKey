local VIM = nil
pcall(function() VIM = game:GetService("VirtualInputManager") end)

local function getRoot()
	local char = LocalPlayer.Character
	return char and char:FindFirstChild("HumanoidRootPart")
end

local function stabilize()
	local root = getRoot()
	if root then
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
	end
end

local function teleport(pos, lift)
	local root = getRoot()
	if not root then
		setStatus("Character not found")
		return false
	end
	root.CFrame = CFrame.new(pos + Vector3.new(0, lift or 3, 0))
	stabilize()
	return true
end

local function sleep(alive, sec)
	local t0 = os.clock()
	while alive() and (os.clock() - t0) < sec do task.wait(0.1) end
end

local function countdown(alive, sec, fmt)
	local t0 = os.clock()
	while alive() and (os.clock() - t0) < sec do
		setStatus(fmt:format(math.max(0, sec - (os.clock() - t0))))
		task.wait(0.1)
	end
end

-- debug log (shown in RITUAL > DIAGNOSTICS, can be copied) --------
local logs = {}
local logLabel
local function logLine(msg)
	table.insert(logs, ("[%s] %s"):format(os.date("%H:%M:%S"), msg))
	if #logs > 250 then table.remove(logs, 1) end
	if logLabel then
		local lines = {}
		for i = math.max(1, #logs - 8), #logs do lines[#lines + 1] = logs[i] end
		logLabel.Text = table.concat(lines, "\n")
	end
end

-- prompts ---------------------------------------------------------
local function promptPos(prompt)
	local p = prompt.Parent
	if not p then return nil end
	if p:IsA("BasePart") then return p.Position end
	if p:IsA("Attachment") then return p.WorldPosition end
	if p:IsA("Model") then return p:GetPivot().Position end
	local part = p:FindFirstAncestorWhichIsA("BasePart")
	return part and part.Position
end

local function promptText(prompt)
	local names = prompt.ActionText .. " " .. prompt.ObjectText .. " " .. prompt.Name
	local p = prompt.Parent
	for _ = 1, 3 do
		if p and p ~= workspace then
			names = names .. " " .. p.Name
			p = p.Parent
		end
	end
	return names:lower()
end

local function findPromptNear(pos, radius, keyword, used)
	local best, bestDist = nil, radius
	for _, d in ipairs(workspace:GetDescendants()) do
		if d:IsA("ProximityPrompt") and d.Enabled and not (used and used[d]) then
			local pp = promptPos(d)
			if pp then
				local dist = (pp - pos).Magnitude
				if dist < bestDist and (not keyword or promptText(d):find(keyword, 1, true)) then
					best, bestDist = d, dist
				end
			end
		end
	end
	return best
end

local function waitPromptNear(alive, pos, radius, keyword, used, timeout)
	local t0 = os.clock()
	while alive() and (os.clock() - t0) < timeout do
		local p = findPromptNear(pos, radius, keyword, used)
		if p then return p end
		task.wait(0.4)
	end
	return nil
end

local function promptDone(prompt)
	return (not prompt.Parent) or (not prompt.Parent:IsDescendantOf(workspace)) or (not prompt.Enabled)
end

-- long press: fireproximityprompt -> real hold -> key hold, stops once used up
local function pressPrompt(prompt, extraDone, quiet)
	local function plog(m) if not quiet then logLine(m) end end
	local function done() return promptDone(prompt) or (extraDone and extraDone()) end

	local pp = promptPos(prompt)
	local root = getRoot()
	local dist = (pp and root) and (root.Position - pp).Magnitude or -1
	local label = prompt.ActionText ~= "" and prompt.ActionText or prompt.Name
	plog(("press '%s' | enabled=%s hold=%.1f max=%.0f dist=%.0f"):format(
		label, tostring(prompt.Enabled), prompt.HoldDuration, prompt.MaxActivationDistance, dist))

	-- a prompt that is not enabled yet: give it a moment instead of calling it "done"
	if not prompt.Enabled then
		local t0 = os.clock()
		while prompt.Parent and not prompt.Enabled and (os.clock() - t0) < 3 do task.wait(0.2) end
		if not prompt.Enabled then
			plog("  prompt stayed disabled")
			return false
		end
	end

	if pp and root and dist > math.max(prompt.MaxActivationDistance * 0.7, 4) then
		teleport(pp)
		task.wait(0.2)
	end

	local hold = prompt.HoldDuration

	if fireproximityprompt then
		pcall(function() prompt.HoldDuration = 0 end)
		pcall(fireproximityprompt, prompt)
		pcall(function() prompt.HoldDuration = hold end)
		task.wait(0.25)
		if done() then plog("  fireproximityprompt -> done") return true end
		plog("  fireproximityprompt -> not done yet")
	else
		plog("  this executor has no fireproximityprompt")
	end

	pcall(function() prompt:InputHoldBegin() end)
	task.wait(hold + 0.3)
	pcall(function() prompt:InputHoldEnd() end)
	task.wait(0.15)
	if done() then plog("  real hold -> done") return true end
	plog("  real hold -> not done yet")

	if VIM then
		local key = prompt.KeyboardKeyCode
		if key == Enum.KeyCode.Unknown then key = Enum.KeyCode.E end
		pcall(function() VIM:SendKeyEvent(true, key, false, game) end)
		task.wait(hold + 0.3)
		pcall(function() VIM:SendKeyEvent(false, key, false, game) end)
		task.wait(0.15)
		plog("  key hold -> done=" .. tostring(done()))
	end
	return done()
end

-- yin & yang lookups ---------------------------------------------
local function getRitualRoot() return workspace:FindFirstChild("HeadlessRitual") end

local fbCache = {}
local function getRitualInst(name)
	local hr = getRitualRoot()
	if not hr then return nil end
	local runtime = hr:FindFirstChild("Runtime")
	local inst = runtime and runtime:FindFirstChild(name)
	if inst then return inst end

	-- fallback: case-insensitive search inside HeadlessRitual (cached, so it stays cheap)
	local c = fbCache[name]
	if c and c.inst and c.inst:IsDescendantOf(workspace) then return c.inst end
	if c and (os.clock() - c.t) < 2 then return nil end
	local found
	local lname = name:lower()
	for _, d in ipairs(hr:GetDescendants()) do
		if (d:IsA("Model") or d:IsA("BasePart")) and d.Name:lower() == lname then found = d break end
	end
	fbCache[name] = { inst = found, t = os.clock() }
	return found
end

local function getRitualPos(name)
	local inst = getRitualInst(name)
	if not inst then return nil end
	local ok, pos = pcall(function() return inst.WorldPivot.Position end)
	if ok and pos then return pos end
	if inst:IsA("Model") then return inst:GetPivot().Position end
	if inst:IsA("BasePart") then return inst.Position end
	return nil
end

-- a prompt that is enabled, else the first prompt we can find
local function firstEnabledPrompt(inst)
	local first
	for _, d in ipairs(inst:GetDescendants()) do
		if d:IsA("ProximityPrompt") then
			if d.Enabled then return d end
			first = first or d
		end
	end
	return first
end

-- no prompts at all = fine; prompts exist = at least one must be enabled
local function hasUsablePrompt(inst)
	local any = false
	for _, d in ipairs(inst:GetDescendants()) do
		if d:IsA("ProximityPrompt") then
			any = true
			if d.Enabled then return true end
		end
	end
	return not any
end

-- any enabled prompt inside HeadlessRitual whose text/names contain `keyword`, nearest first
local function findPromptInRitual(keyword, nearPos, used)
	local hr = getRitualRoot()
	if not hr then return nil end
	local best, bestDist = nil, math.huge
	for _, d in ipairs(hr:GetDescendants()) do
		if d:IsA("ProximityPrompt") and d.Enabled and not (used and used[d])
			and (not keyword or promptText(d):find(keyword, 1, true)) then
			local pp = promptPos(d)
			local dist = (pp and nearPos) and (pp - nearPos).Magnitude or 0
			if dist < bestDist then best, bestDist = d, dist end
		end
	end
	return best
end

local availCache = { t = 0, ok = false, why = "checking..." }
local function yyStatus()
	if os.clock() - availCache.t < 0.3 then return availCache.ok, availCache.why end
	local ok, why = true, ""
	if not getRitualRoot() then
		ok, why = false, "HeadlessRitual not loaded"
	else
		for _, name in ipairs({ "Yin", "Yang" }) do
			local inst = getRitualInst(name)
			if not inst then
				ok, why = false, name .. " missing"
				break
			end
			if not hasUsablePrompt(inst) then
				ok, why = false, name .. " prompt disabled"
				break
			end
		end
	end
	availCache = { t = os.clock(), ok = ok, why = why }
	return ok, why
end

local function yyAvailable() return (yyStatus()) end

local function yyReady()
	return yyOn and os.clock() >= yyNextAllowed and yyAvailable()
end

-- candy helpers ---------------------------------------------------
local function getRemote()
	local r = ReplicatedStorage:FindFirstChild("Remotes")
	r = r and r:FindFirstChild("Game")
	return r and r:FindFirstChild("CollectCandy")
end

local function candyType(name)
	local t = name:match("^Candy(%d+)_%d+$") or name:match("^Candy_0*(%d+)$")
	return t and tonumber(t)
end

local function instPosition(inst)
	if inst:IsA("BasePart") then return inst.Position end
	if inst:IsA("Model") then return inst:GetPivot().Position end
end

local function findCandies()
	local list = {}
	for _, inst in ipairs(workspace:GetDescendants()) do
		if inst:IsA("BasePart") or inst:IsA("Model") then
			local t = candyType(inst.Name)
			if t and selected[t] and inst:IsDescendantOf(workspace) then
				local pos = instPosition(inst)
				if pos then table.insert(list, { inst = inst, name = inst.Name, pos = pos, type = t }) end
			end
		end
	end
	return list
end

local function rank(c)
	if not priorityOn then return 3 end
	if c.type == 4 then return 1 end
	if c.type == 3 then return 2 end
	return 3
end

local function isGone(c)
	return (not c.inst) or (not c.inst.Parent) or (not c.inst:IsDescendantOf(workspace))
end

local function findCandyPrompt(c)
	local p = c.inst:FindFirstChildWhichIsA("ProximityPrompt", true)
	if p then return p end
	local par = c.inst.Parent
	for _ = 1, 2 do
		if par and par ~= workspace then
			p = par:FindFirstChildWhichIsA("ProximityPrompt", true)
			if p then return p end
			par = par.Parent
		end
	end
	return findPromptNear(c.pos, 15)
end

local function collectCandy(c)
	local prompt = findCandyPrompt(c)
	local remote = getRemote()
	setStatus(("Pickup %s | prompt:%s remote:%s"):format(c.name, prompt and "yes" or "NO", remote and "yes" or "NO"))
	if prompt then
		pressPrompt(prompt, function() return isGone(c) end, true)
		if isGone(c) then return true end
	end
	if remote then
		pcall(function() remote:FireServer(c.name) end)
		task.wait(0.2)
	end
	return isGone(c)
end

local skipUntil = setmetatable({}, { __mode = "k" })
local setMode -- assigned after the AUTO page is built

local function isCandyPrompt(prompt)
	local p = prompt.Parent
	for _ = 1, 3 do
		if not p or p == workspace then break end
		if p.Name:match("^Candy%d+_%d+$") or p.Name:match("^Candy_0*%d+$") then return true end
		p = p.Parent
	end
	return false
end

-- nearest enabled prompt around `origin` (candy prompts excluded). A prompt whose text/names contain
-- `keyword` wins over a nearer one that doesn't; otherwise the nearest one is used.
local function findPromptWide(origin, radius, keyword, used, skip)
	local bestKw, bestKwD, bestAny, bestAnyD = nil, radius, nil, radius
	for _, d in ipairs(workspace:GetDescendants()) do
		if d:IsA("ProximityPrompt") and d.Enabled and not (used and used[d])
			and not isCandyPrompt(d) and not (skip and skip(d)) then
			local pp = promptPos(d)
			if pp then
				local dist = (pp - origin).Magnitude
				if dist < bestAnyD then bestAny, bestAnyD = d, dist end
				if keyword and dist < bestKwD and promptText(d):find(keyword, 1, true) then
					bestKw, bestKwD = d, dist
				end
			end
		end
	end
	return bestKw or bestAny
end

-- log every prompt around a point (enabled or not) so we can see what the game really has there
local function dumpPrompts(label, origin, radius)
	local list = {}
	for _, d in ipairs(workspace:GetDescendants()) do
		if d:IsA("ProximityPrompt") then
			local pp = promptPos(d)
			if pp then
				local dist = (pp - origin).Magnitude
				if dist <= radius then list[#list + 1] = { d = d, dist = dist } end
			end
		end
	end
	table.sort(list, function(a, b) return a.dist < b.dist end)
	logLine(("%s: %d prompts within %d studs"):format(label, #list, radius))
	for i = 1, math.min(#list, 6) do
		local d = list[i].d
		local full = d:GetFullName()
		if #full > 64 then full = "..." .. full:sub(-61) end
		logLine(("  %s | '%s' en=%s d=%.0f"):format(full, d.ActionText, tostring(d.Enabled), list[i].dist))
	end
end

local function anyCandy() return selected[1] or selected[2] or selected[3] or selected[4] end

-- one candy per round --------------------------------------------
local function runCandyRound(alive)
	local root = getRoot()
	if not root then sleep(alive, 0.5) return end

	local candies = {}
	for _, c in ipairs(findCandies()) do
		if not skipUntil[c.inst] or os.clock() > skipUntil[c.inst] then table.insert(candies, c) end
	end
	if #candies == 0 then
		setStatus("No selected candy found...")
		sleep(alive, 0.5)
		return
	end

	table.sort(candies, function(a, b)
		local ra, rb = rank(a), rank(b)
		if ra ~= rb then return ra < rb end
		return (a.pos - root.Position).Magnitude < (b.pos - root.Position).Magnitude
	end)
	local target = candies[1]
	local roundStart = os.clock()

	setStatus("Going to " .. target.name)
	teleport(target.pos, 2)
	sleep(alive, 0.2)

	if alive() then
		if not collectCandy(target) then
			skipUntil[target.inst] = os.clock() + 8
			setStatus("Could not pick " .. target.name .. " - skipping")
		end
	end

	-- stay until the timer is met (Yin & Yang can interrupt this)
	while alive() and (os.clock() - roundStart) < interval do
		if yyReady() then
			setStatus("☯ Yin & Yang ready - switching!")
			return
		end
		setStatus(("Picked %s - waypoint in %.1fs"):format(target.name, math.max(0, interval - (os.clock() - roundStart))))
		stabilize()
		task.wait(0.1)
	end

	if alive() then
		setStatus("Timer met - at checkpoint")
		teleport(yyCheckpointWp)
		sleep(alive, WAYPOINT_REST)
	end
end

-- full yin & yang session -----------------------------------------
local function runYinYang(alive)
	logLine("=== Yin & Yang session ===")
	local used = {}

	-- 1 + 2) collect Yin, then Yang (the object may move, so we follow it while searching)
	for _, name in ipairs({ "Yin", "Yang" }) do
		if not alive() then return end
		setStatus("☯ Collecting " .. name .. "...")
		local pos = getRitualPos(name)
		if not pos then
			logLine(name .. " object not found")
			setStatus(name .. " not found - skipping")
			sleep(alive, 1)
		else
			logLine(("%s at %.0f, %.0f, %.0f"):format(name, pos.X, pos.Y, pos.Z))
			teleport(pos)
			sleep(alive, 0.6)

			local inst = getRitualInst(name)
			local how = "inside the model"
			local prompt = inst and firstEnabledPrompt(inst)
			if not prompt then
				how = "near it"
				local t0 = os.clock()
				while alive() and not prompt and (os.clock() - t0) < 7 do
					local cur = getRitualPos(name) or pos
					local root = getRoot()
					if root and (root.Position - cur).Magnitude > 12 then
						teleport(cur)
						sleep(alive, 0.3)
					end
					prompt = findPromptWide(cur, 120, name:lower(), used)
					if not prompt then task.wait(0.4) end
				end
			end

			if prompt then
				logLine(("%s prompt found %s: %s"):format(name, how, prompt:GetFullName():sub(-50)))
				used[prompt] = true
				pressPrompt(prompt)
			else
				logLine("NO prompt found for " .. name)
				setStatus("No prompt found for " .. name)
				dumpPrompts(name, getRitualPos(name) or pos, 150)
				sleep(alive, 1)
			end
		end
	end

	-- 3) submit at the seal (separate long press for each)
	if not alive() then return end
	setStatus("☯ Going to Seal...")
	teleport(yySealWp)
	sleep(alive, 0.8)

	local function skipPot(p)
		local pp = promptPos(p)
		return pp and (pp - POT_POS).Magnitude < 8
	end

	for _, name in ipairs({ "Yin", "Yang" }) do
		if not alive() then return end
		setStatus("☯ Submitting " .. name .. "...")
		local kw = name:lower()
		local prompt
		local t0 = os.clock()
		while alive() and not prompt and (os.clock() - t0) < 7 do
			prompt = findPromptWide(yySealWp, 120, kw, used, skipPot)
			if not prompt then task.wait(0.4) end
		end

		if prompt then
			logLine(("submit %s prompt found: %s"):format(name, prompt:GetFullName():sub(-50)))
			used[prompt] = true
			pressPrompt(prompt)
			sleep(alive, 0.4)
		else
			logLine("NO submit prompt found for " .. name)
			setStatus("No submit prompt found for " .. name)
			dumpPrompts("Seal (" .. name .. ")", yySealWp, 150)
			sleep(alive, 1)
		end
	end

	countdown(alive, SEAL_OPEN_WAIT, "☯ Seal opening... %.1fs")

	-- 4) candy pot inside the seal
	if not alive() then return end
	setStatus("☯ Collecting candy pot...")
	teleport(POT_POS)
	sleep(alive, 0.6)
	local pot
	local t0 = os.clock()
	while alive() and not pot and (os.clock() - t0) < 7 do
		pot = findPromptWide(POT_POS, 60, "pot", used)
		if not pot then task.wait(0.4) end
	end
	if pot then
		logLine("candy pot prompt found: " .. pot:GetFullName():sub(-50))
		pressPrompt(pot)
	else
		logLine("NO candy pot prompt found")
		setStatus("Candy pot prompt not found")
		dumpPrompts("Pot", POT_POS, 100)
		sleep(alive, 1)
	end

	countdown(alive, BEFORE_CHECKPOINT_WAIT, "☯ Checkpoint in %.1fs")

	-- 5) checkpoint
	if not alive() then return end
	setStatus("☯ Going to Checkpoint")
	teleport(yyCheckpointWp)
	logLine("=== session done ===")
	sleep(alive, 0.6)
end

-- master loop: Yin & Yang first when available, else candy ---------
local function mainLoop(alive)
	while alive() do
		if yyReady() then
			setMode("YIN & YANG", ACCENT2)
			runYinYang(alive)
			yyNextAllowed = os.clock() + yyCooldown
		elseif farmOn and anyCandy() then
			setMode("CANDY FARM", WARN)
			runCandyRound(alive)
		else
			setMode("WAITING", SUB)
			setStatus("Waiting for Yin & Yang...")
			sleep(alive, 0.5)
		end
	end
end

-- worker control ---------------------------------------------------
local setRunningUI -- assigned after the AUTO page is built

local function startWorker(fn)
	if running then return false end
	running = true
	runId += 1
	local id = runId
	setRunningUI(true)
	task.spawn(function()
		fn(function() return running and runId == id end)
		if runId == id then
			running = false
			setRunningUI(false)
			setStatus("Finished")
		end
	end)
	return true
end

local function stopAll()
	running = false
	runId += 1
	setRunningUI(false)
	setStatus("Stopped")
end

local function startAuto()
	if running then return end
	local farmActive = farmOn and anyCandy()
	if not farmActive and not yyOn then
		if farmOn then
			setStatus("⚠ Pick candy types in FARM, or turn on Yin & Yang")
			showTab("farm")
		else
			setStatus("⚠ Turn on Candy Farm or Yin & Yang")
		end
		return
	end
	if not farmActive then
		setStatus("No candy ticked - waiting for Yin & Yang only")
	end
	startWorker(mainLoop)
end

