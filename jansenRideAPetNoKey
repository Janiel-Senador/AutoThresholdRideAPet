local VIM = nil
pcall(function() VIM = game:GetService("VirtualInputManager") end)

local function getRoot()
	local char = LocalPlayer.Character
	return char and char:FindFirstChild("HumanoidRootPart")
end

local function stabilize()
	local root = getRoot()
	if root then
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
	end
end

local function teleport(pos, lift)
	local root = getRoot()
	if not root then
		setStatus("Character not found")
		return false
	end
	root.CFrame = CFrame.new(pos + Vector3.new(0, lift or 3, 0))
	stabilize()
	return true
end

local function sleep(alive, sec)
	local t0 = os.clock()
	while alive() and (os.clock() - t0) < sec do task.wait(0.1) end
end

local function countdown(alive, sec, fmt)
	local t0 = os.clock()
	while alive() and (os.clock() - t0) < sec do
		setStatus(fmt:format(math.max(0, sec - (os.clock() - t0))))
		task.wait(0.1)
	end
end

-- prompts ---------------------------------------------------------
local function promptPos(prompt)
	local p = prompt.Parent
	if not p then return nil end
	if p:IsA("BasePart") then return p.Position end
	if p:IsA("Attachment") then return p.WorldPosition end
	if p:IsA("Model") then return p:GetPivot().Position end
	local part = p:FindFirstAncestorWhichIsA("BasePart")
	return part and part.Position
end

local function promptText(prompt)
	local names = prompt.ActionText .. " " .. prompt.ObjectText .. " " .. prompt.Name
	local p = prompt.Parent
	for _ = 1, 3 do
		if p and p ~= workspace then
			names = names .. " " .. p.Name
			p = p.Parent
		end
	end
	return names:lower()
end

local function findPromptNear(pos, radius, keyword, used)
	local best, bestDist = nil, radius
	for _, d in ipairs(workspace:GetDescendants()) do
		if d:IsA("ProximityPrompt") and d.Enabled and not (used and used[d]) then
			local pp = promptPos(d)
			if pp then
				local dist = (pp - pos).Magnitude
				if dist < bestDist and (not keyword or promptText(d):find(keyword, 1, true)) then
					best, bestDist = d, dist
				end
			end
		end
	end
	return best
end

local function waitPromptNear(alive, pos, radius, keyword, used, timeout)
	local t0 = os.clock()
	while alive() and (os.clock() - t0) < timeout do
		local p = findPromptNear(pos, radius, keyword, used)
		if p then return p end
		task.wait(0.4)
	end
	return nil
end

local function promptDone(prompt)
	return (not prompt.Parent) or (not prompt.Parent:IsDescendantOf(workspace)) or (not prompt.Enabled)
end

-- long press: fireproximityprompt -> real hold -> key hold, stops once used up
local function pressPrompt(prompt, extraDone)
	local function done() return promptDone(prompt) or (extraDone and extraDone()) end

	local pp = promptPos(prompt)
	local root = getRoot()
	if pp and root and (root.Position - pp).Magnitude > math.max(prompt.MaxActivationDistance * 0.7, 4) then
		teleport(pp)
		task.wait(0.2)
	end

	local hold = prompt.HoldDuration

	if fireproximityprompt then
		pcall(function() prompt.HoldDuration = 0 end)
		pcall(fireproximityprompt, prompt)
		pcall(function() prompt.HoldDuration = hold end)
		task.wait(0.25)
		if done() then return true end
	end

	pcall(function() prompt:InputHoldBegin() end)
	task.wait(hold + 0.3)
	pcall(function() prompt:InputHoldEnd() end)
	task.wait(0.15)
	if done() then return true end

	if VIM then
		local key = prompt.KeyboardKeyCode
		if key == Enum.KeyCode.Unknown then key = Enum.KeyCode.E end
		pcall(function() VIM:SendKeyEvent(true, key, false, game) end)
		task.wait(hold + 0.3)
		pcall(function() VIM:SendKeyEvent(false, key, false, game) end)
		task.wait(0.15)
	end
	return done()
end

-- yin & yang lookups ---------------------------------------------
local function getRitualInst(name)
	local hr = workspace:FindFirstChild("HeadlessRitual")
	local runtime = hr and hr:FindFirstChild("Runtime")
	return runtime and runtime:FindFirstChild(name)
end

local function getRitualPos(name)
	local inst = getRitualInst(name)
	if not inst then return nil end
	local ok, pos = pcall(function() return inst.WorldPivot.Position end)
	if ok and pos then return pos end
	if inst:IsA("Model") then return inst:GetPivot().Position end
	if inst:IsA("BasePart") then return inst.Position end
	return nil
end

-- Yin AND Yang exist (and their prompts, if any, are enabled)
local function yyAvailable()
	for _, name in ipairs({ "Yin", "Yang" }) do
		local inst = getRitualInst(name)
		if not inst then return false end
		local p = inst:FindFirstChildWhichIsA("ProximityPrompt", true)
		if p and not p.Enabled then return false end
	end
	return true
end

local function yyReady()
	return yyOn and os.clock() >= yyNextAllowed and yyAvailable()
end

-- candy helpers ---------------------------------------------------
local function getRemote()
	local r = ReplicatedStorage:FindFirstChild("Remotes")
	r = r and r:FindFirstChild("Game")
	return r and r:FindFirstChild("CollectCandy")
end

local function candyType(name)
	local t = name:match("^Candy(%d+)_%d+$") or name:match("^Candy_0*(%d+)$")
	return t and tonumber(t)
end

local function instPosition(inst)
	if inst:IsA("BasePart") then return inst.Position end
	if inst:IsA("Model") then return inst:GetPivot().Position end
end

local function findCandies()
	local list = {}
	for _, inst in ipairs(workspace:GetDescendants()) do
		if inst:IsA("BasePart") or inst:IsA("Model") then
			local t = candyType(inst.Name)
			if t and selected[t] and inst:IsDescendantOf(workspace) then
				local pos = instPosition(inst)
				if pos then table.insert(list, { inst = inst, name = inst.Name, pos = pos, type = t }) end
			end
		end
	end
	return list
end

local function rank(c)
	if not priorityOn then return 3 end
	if c.type == 4 then return 1 end
	if c.type == 3 then return 2 end
	return 3
end

local function isGone(c)
	return (not c.inst) or (not c.inst.Parent) or (not c.inst:IsDescendantOf(workspace))
end

local function findCandyPrompt(c)
	local p = c.inst:FindFirstChildWhichIsA("ProximityPrompt", true)
	if p then return p end
	local par = c.inst.Parent
	for _ = 1, 2 do
		if par and par ~= workspace then
			p = par:FindFirstChildWhichIsA("ProximityPrompt", true)
			if p then return p end
			par = par.Parent
		end
	end
	return findPromptNear(c.pos, 15)
end

local function collectCandy(c)
	local prompt = findCandyPrompt(c)
	local remote = getRemote()
	setStatus(("Pickup %s | prompt:%s remote:%s"):format(c.name, prompt and "yes" or "NO", remote and "yes" or "NO"))
	if prompt then
		pressPrompt(prompt, function() return isGone(c) end)
		if isGone(c) then return true end
	end
	if remote then
		pcall(function() remote:FireServer(c.name) end)
		task.wait(0.2)
	end
	return isGone(c)
end

local skipUntil = setmetatable({}, { __mode = "k" })
local setMode -- assigned after the AUTO page is built

-- one candy per round --------------------------------------------
local function runCandyRound(alive)
	local root = getRoot()
	if not root then sleep(alive, 0.5) return end

	local candies = {}
	for _, c in ipairs(findCandies()) do
		if not skipUntil[c.inst] or os.clock() > skipUntil[c.inst] then table.insert(candies, c) end
	end
	if #candies == 0 then
		setStatus("No selected candy found...")
		sleep(alive, 0.5)
		return
	end

	table.sort(candies, function(a, b)
		local ra, rb = rank(a), rank(b)
		if ra ~= rb then return ra < rb end
		return (a.pos - root.Position).Magnitude < (b.pos - root.Position).Magnitude
	end)
	local target = candies[1]
	local roundStart = os.clock()

	setStatus("Going to " .. target.name)
	teleport(target.pos, 2)
	sleep(alive, 0.2)

	if alive() then
		if not collectCandy(target) then
			skipUntil[target.inst] = os.clock() + 8
			setStatus("Could not pick " .. target.name .. " - skipping")
		end
	end

	-- stay until the timer is met (Yin & Yang can interrupt this)
	while alive() and (os.clock() - roundStart) < interval do
		if yyReady() then
			setStatus("☯ Yin & Yang ready - switching!")
			return
		end
		setStatus(("Picked %s - waypoint in %.1fs"):format(target.name, math.max(0, interval - (os.clock() - roundStart))))
		stabilize()
		task.wait(0.1)
	end

	if alive() and farmWaypoint then
		setStatus("Timer met - at waypoint")
		teleport(farmWaypoint)
		sleep(alive, WAYPOINT_REST)
	end
end

-- full yin & yang session -----------------------------------------
local function runYinYang(alive)
	-- 1 + 2) collect Yin, then Yang
	for _, name in ipairs({ "Yin", "Yang" }) do
		if not alive() then return end
		setStatus("☯ Collecting " .. name .. "...")
		local pos = getRitualPos(name)
		if not pos then
			setStatus(name .. " not found - skipping")
			sleep(alive, 1)
		else
			teleport(pos)
			sleep(alive, 0.5)
			local inst = getRitualInst(name)
			local prompt = inst and inst:FindFirstChildWhichIsA("ProximityPrompt", true)
			prompt = prompt or waitPromptNear(alive, pos, 25, name:lower(), nil, 4)
			prompt = prompt or waitPromptNear(alive, pos, 15, nil, nil, 2)
			if prompt then
				pressPrompt(prompt)
			else
				setStatus("No prompt found for " .. name)
				sleep(alive, 1)
			end
		end
	end

	-- 3) submit at the seal
	if not alive() then return end
	setStatus("☯ Going to Seal...")
	teleport(yySealWp)
	sleep(alive, 0.8)

	local used = {}
	for _, name in ipairs({ "Yin", "Yang" }) do
		if not alive() then return end
		setStatus("☯ Submitting " .. name .. "...")
		local prompt = waitPromptNear(alive, yySealWp, 45, name:lower(), used, 3)
			or waitPromptNear(alive, yySealWp, 45, nil, used, 2)
		if prompt then
			used[prompt] = true
			pressPrompt(prompt)
			sleep(alive, 0.4)
		else
			setStatus("No submit prompt found for " .. name)
			sleep(alive, 1)
		end
	end

	countdown(alive, SEAL_OPEN_WAIT, "☯ Seal opening... %.1fs")

	-- 4) candy pot
	if not alive() then return end
	setStatus("☯ Collecting candy pot...")
	teleport(POT_POS)
	sleep(alive, 0.6)
	local pot = waitPromptNear(alive, POT_POS, 25, nil, used, 4)
	if pot then
		pressPrompt(pot)
	else
		setStatus("Candy pot prompt not found")
		sleep(alive, 1)
	end

	countdown(alive, BEFORE_CHECKPOINT_WAIT, "☯ Checkpoint in %.1fs")

	-- 5) checkpoint
	if not alive() then return end
	setStatus("☯ Going to Checkpoint")
	teleport(yyCheckpointWp)
	sleep(alive, 0.6)
end

-- master loop: Yin & Yang first when available, else candy ---------
local function mainLoop(alive)
	while alive() do
		if yyReady() then
			setMode("YIN & YANG", ACCENT2)
			runYinYang(alive)
			yyNextAllowed = os.clock() + yyCooldown
		elseif farmOn then
			setMode("CANDY FARM", WARN)
			runCandyRound(alive)
		else
			setMode("WAITING", SUB)
			setStatus("Waiting for Yin & Yang...")
			sleep(alive, 0.5)
		end
	end
end

-- worker control ---------------------------------------------------
local setRunningUI -- assigned after the AUTO page is built

local function startWorker(fn)
	if running then return false end
	running = true
	runId += 1
	local id = runId
	setRunningUI(true)
	task.spawn(function()
		fn(function() return running and runId == id end)
		if runId == id then
			running = false
			setRunningUI(false)
			setStatus("Finished")
		end
	end)
	return true
end

local function stopAll()
	running = false
	runId += 1
	setRunningUI(false)
	setStatus("Stopped")
end

local function startAuto()
	if running then return end
	if not farmOn and not yyOn then
		setStatus("⚠ Turn on Candy Farm or Yin & Yang")
		return
	end
	if farmOn then
		if not (selected[1] or selected[2] or selected[3] or selected[4]) then
			setStatus("⚠ Pick candy types in the FARM tab")
			showTab("farm")
			return
		end
		if not farmWaypoint then
			setStatus("⚠ Set the farm waypoint in the FARM tab")
			showTab("farm")
			return
		end
	end
	startWorker(mainLoop)
end

