local function tween(obj, t, props, style, dir)
	local tw = TweenService:Create(obj, TweenInfo.new(t, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
	tw:Play()
	return tw
end

local function make(class, props, par)
	local o = Instance.new(class)
	for k, v in pairs(props) do o[k] = v end
	o.Parent = par
	return o
end

local function round(obj, r) return make("UICorner", { CornerRadius = UDim.new(0, r) }, obj) end

local function stroke(obj, transparency, color, thickness)
	return make("UIStroke", {
		Color = color or WHITE,
		Transparency = transparency or 0.85,
		Thickness = thickness or 1,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	}, obj)
end

local function text(par, props)
	local d = {
		BackgroundTransparency = 1, BorderSizePixel = 0, TextColor3 = TEXT,
		Font = Enum.Font.Gotham, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left,
	}
	for k, v in pairs(props) do d[k] = v end
	return make("TextLabel", d, par)
end

