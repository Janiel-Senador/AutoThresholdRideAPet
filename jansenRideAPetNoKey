-- low graphics (fully reversible)
local origs = setmetatable({}, { __mode = "k" })
local removedSA = {}
local globals = {}
local gfxConnected = false

local function remember(obj, props)
	if origs[obj] then return end
	local t = {}
	for _, k in ipairs(props) do
		local ok, v = pcall(function() return obj[k] end)
		if ok then t[k] = v end
	end
	origs[obj] = t
end

local function killEffect(obj)
	if obj.Name == "JanGlassBlur" then return end
	if obj:IsA("BloomEffect") or obj:IsA("BlurEffect") or obj:IsA("SunRaysEffect")
		or obj:IsA("ColorCorrectionEffect") or obj:IsA("DepthOfFieldEffect") then
		remember(obj, { "Enabled" })
		obj.Enabled = false
	elseif obj:IsA("Atmosphere") then
		remember(obj, { "Density", "Haze" })
		obj.Density = 0
		obj.Haze = 0
	end
end

local function reduce(obj)
	if obj:IsA("BasePart") then
		if obj:IsA("MeshPart") then
			remember(obj, { "Material", "Reflectance", "CastShadow", "RenderFidelity", "TextureID" })
		else
			remember(obj, { "Material", "Reflectance", "CastShadow" })
		end
		obj.Material = Enum.Material.SmoothPlastic
		obj.Reflectance = 0
		obj.CastShadow = false
		if obj:IsA("MeshPart") then
			safe(function() obj.RenderFidelity = Enum.RenderFidelity.Performance end)
			safe(function() obj.TextureID = "" end)
		end
	elseif obj:IsA("Decal") or obj:IsA("Texture") then
		remember(obj, { "Transparency" })
		obj.Transparency = 1
	elseif obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam")
		or obj:IsA("Fire") or obj:IsA("Smoke") or obj:IsA("Sparkles") then
		remember(obj, { "Enabled" })
		obj.Enabled = false
	elseif obj:IsA("PointLight") or obj:IsA("SpotLight") or obj:IsA("SurfaceLight") then
		remember(obj, { "Enabled" })
		obj.Enabled = false
	elseif obj:IsA("Explosion") then
		remember(obj, { "Visible" })
		obj.Visible = false
	elseif obj:IsA("SurfaceAppearance") then
		table.insert(removedSA, { obj = obj, parent = obj.Parent })
		safe(function() obj.Parent = nil end)
	elseif obj:IsA("Sound") then
		remember(obj, { "Volume" })
		obj.Volume = 0
	end
end

local function applyLowGraphics()
	if lowGfxApplied then return end
	lowGfxApplied = true

	globals.quality = settings().Rendering.QualityLevel
	globals.meshDetail = settings().Rendering.MeshPartDetailLevel
	safe(function() globals.volume = UserSettings():GetService("UserGameSettings").MasterVolume end)
	safe(function()
		globals.light = {
			GlobalShadows = Lighting.GlobalShadows, FogEnd = Lighting.FogEnd, Brightness = Lighting.Brightness,
			EnvironmentDiffuseScale = Lighting.EnvironmentDiffuseScale,
			EnvironmentSpecularScale = Lighting.EnvironmentSpecularScale, ShadowSoftness = Lighting.ShadowSoftness,
		}
	end)
	safe(function() globals.tech = gethiddenproperty(Lighting, "Technology") end)
	safe(function()
		local t = workspace.Terrain
		globals.water = {
			WaterWaveSize = t.WaterWaveSize, WaterWaveSpeed = t.WaterWaveSpeed,
			WaterReflectance = t.WaterReflectance, WaterTransparency = t.WaterTransparency,
		}
	end)
	safe(function() globals.decoration = gethiddenproperty(workspace.Terrain, "Decoration") end)

	safe(function() settings().Rendering.QualityLevel = Enum.QualityLevel.Level01 end)
	safe(function() settings().Rendering.MeshPartDetailLevel = Enum.MeshPartDetailLevel.Level01 end)
	safe(function() UserSettings():GetService("UserGameSettings").MasterVolume = 0 end)
	safe(function()
		Lighting.GlobalShadows = false
		Lighting.FogEnd = 9e9
		Lighting.Brightness = 1
		Lighting.EnvironmentDiffuseScale = 0
		Lighting.EnvironmentSpecularScale = 0
		Lighting.ShadowSoftness = 0
	end)
	safe(function() sethiddenproperty(Lighting, "Technology", Enum.Technology.Legacy) end)
	for _, o in ipairs(Lighting:GetChildren()) do safe(killEffect, o) end
	safe(function()
		local t = workspace.Terrain
		t.WaterWaveSize = 0
		t.WaterWaveSpeed = 0
		t.WaterReflectance = 0
		t.WaterTransparency = 1
		sethiddenproperty(t, "Decoration", false)
	end)

	task.spawn(function()
		local n = 0
		for _, o in ipairs(workspace:GetDescendants()) do
			if not lowGfxApplied then return end
			safe(reduce, o)
			n += 1
			if n % 400 == 0 then task.wait() end
		end
	end)

	if not gfxConnected then
		gfxConnected = true
		workspace.DescendantAdded:Connect(function(o) if lowGfxApplied then safe(reduce, o) end end)
		Lighting.ChildAdded:Connect(function(o) if lowGfxApplied then safe(killEffect, o) end end)
	end
end

local function restoreGraphics()
	if not lowGfxApplied then return end
	lowGfxApplied = false
	for obj, props in pairs(origs) do
		for k, v in pairs(props) do pcall(function() obj[k] = v end) end
		origs[obj] = nil
	end
	for _, r in ipairs(removedSA) do pcall(function() r.obj.Parent = r.parent end) end
	removedSA = {}

	if globals.quality then safe(function() settings().Rendering.QualityLevel = globals.quality end) end
	if globals.meshDetail then safe(function() settings().Rendering.MeshPartDetailLevel = globals.meshDetail end) end
	if globals.volume then safe(function() UserSettings():GetService("UserGameSettings").MasterVolume = globals.volume end) end
	if globals.light then
		for k, v in pairs(globals.light) do safe(function() Lighting[k] = v end) end
	end
	if globals.tech then safe(function() sethiddenproperty(Lighting, "Technology", globals.tech) end) end
	if globals.water then
		for k, v in pairs(globals.water) do safe(function() workspace.Terrain[k] = v end) end
	end
	if globals.decoration ~= nil then
		safe(function() sethiddenproperty(workspace.Terrain, "Decoration", globals.decoration) end)
	end
end

