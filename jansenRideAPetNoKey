local tabToken = 0
showTab = function(id, instant)
	if currentTab == id then return end
	tabToken += 1
	local token = tabToken
	local newIdx
	for i, t in ipairs(TABS) do if t.id == id then newIdx = i end end
	local dir = (newIdx > tabIndex) and 1 or -1

	local oldPage = currentTab and pages[currentTab]
	local newPageFrame = pages[id]

	newPageFrame.Position = UDim2.fromScale(instant and 0 or dir, 0)
	newPageFrame.Visible = true
	if not instant then
		tween(newPageFrame, 0.32, { Position = UDim2.fromScale(0, 0) }, Enum.EasingStyle.Quint)
		if oldPage then
			tween(oldPage, 0.32, { Position = UDim2.fromScale(-dir, 0) }, Enum.EasingStyle.Quint)
			task.delay(0.34, function()
				if tabToken == token then oldPage.Visible = false end
			end)
		end
		pulseBlur()
	elseif oldPage then
		oldPage.Visible = false
	end

	tween(Indicator, 0.3, { Position = UDim2.new((newIdx - 1) / #TABS, 3, 0, 3) }, Enum.EasingStyle.Back)
	for i, b in ipairs(tabButtons) do
		tween(b, 0.2, { TextColor3 = (i == newIdx) and WHITE or SUB })
	end
	currentTab, tabIndex = id, newIdx
end

for i, t in ipairs(TABS) do
	local b = make("TextButton", {
