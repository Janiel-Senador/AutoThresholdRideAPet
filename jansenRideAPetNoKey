-- diagnostics -------------------------------------------------------
local function describePrompt(d, refPos)
	local pp = promptPos(d)
	local dist = (pp and refPos) and (pp - refPos).Magnitude or -1
	return ("%s | %s en=%s hold=%.1f max=%.0f d=%.0f"):format(
		d.ActionText, d.ObjectText ~= "" and d.ObjectText or d.Name, tostring(d.Enabled),
		d.HoldDuration, d.MaxActivationDistance, dist)
end

local function promptsNear(pos, radius)
	local list = {}
	for _, d in ipairs(workspace:GetDescendants()) do
		if d:IsA("ProximityPrompt") then
			local pp = promptPos(d)
			if pp then
				local dist = (pp - pos).Magnitude
				if dist <= radius then table.insert(list, { d = d, dist = dist }) end
			end
		end
	end
	table.sort(list, function(a, b) return a.dist < b.dist end)
	return list
end

local function scanRitual()
	logLine("--- SCAN ---")
	local hr = getRitualRoot()
	logLine("HeadlessRitual: " .. (hr and "found" or "NOT loaded (too far away / not streamed in)"))
	local rt = hr and hr:FindFirstChild("Runtime")
	if rt then
		local names = {}
		for _, c in ipairs(rt:GetChildren()) do names[#names + 1] = c.Name end
		logLine("Runtime: " .. (#names > 0 and table.concat(names, ", ") or "(empty)"))
	elseif hr then
		logLine("Runtime: missing")
	end
	for _, name in ipairs({ "Yin", "Yang" }) do
		local inst = getRitualInst(name)
		if inst then
			local pos = getRitualPos(name)
			logLine(("%s: %s at %s"):format(name, inst.ClassName,
				pos and ("%.0f, %.0f, %.0f"):format(pos.X, pos.Y, pos.Z) or "?"))
			for _, d in ipairs(inst:GetDescendants()) do
				if d:IsA("ProximityPrompt") then logLine("  prompt " .. describePrompt(d, pos)) end
			end
		else
			logLine(name .. ": missing")
		end
	end
	availCache.t = 0
	local ok, why = yyStatus()
	logLine("Available: " .. tostring(ok) .. (ok and "" or (" (" .. why .. ")")))
	for _, spot in ipairs({ { "Seal", yySealWp }, { "Pot", POT_POS } }) do
		local list = promptsNear(spot[2], 80)
		logLine(("Prompts near %s: %d"):format(spot[1], #list))
		for i = 1, math.min(#list, 4) do logLine("  " .. describePrompt(list[i].d, spot[2])) end
	end
	setStatus("Scan done - see the log in RITUAL")
end

