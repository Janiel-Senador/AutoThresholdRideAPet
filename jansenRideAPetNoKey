task.spawn(function()
	while Gui.Parent do
		if not minimized then
			local root = getRoot()
			if root then
				lastPos = root.Position
				PosLabel.Text = ("X %.0f   Y %.0f   Z %.0f   (tap to copy)"):format(lastPos.X, lastPos.Y, lastPos.Z)
			else
				PosLabel.Text = "X --   Y --   Z --"
			end

			local ready = yyAvailable()
			AvailText.Text = ready and "☯ Yin & Yang: AVAILABLE" or "☯ Yin & Yang: not available"
			tween(AvailText, 0.2, { TextColor3 = ready and GOOD or SUB })
			tween(AvailDot, 0.2, { BackgroundColor3 = ready and GOOD or SUB })
		end
		task.wait(0.5)
	end
end)

