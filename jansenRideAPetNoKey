-- animation freeze
local hooked = setmetatable({}, { __mode = "k" })
local function hookAnimator(animator)
	if hooked[animator] then return end
	hooked[animator] = true
	animator.AnimationPlayed:Connect(function(track)
		if ANIM_OFF then safe(function() track:Stop(0) end) end
	end)
	if ANIM_OFF then
		for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
			safe(function() track:Stop(0) end)
		end
	end
end
local function freezeOwnAnimate(char)
	local anim = char and char:FindFirstChild("Animate")
