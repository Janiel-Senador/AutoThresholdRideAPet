local function row(par, h)
	local f = make("Frame", { Size = UDim2.new(1, 0, 0, h or 38), BackgroundTransparency = 1, LayoutOrder = nextOrder() }, par)
	make("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8),
		SortOrder = Enum.SortOrder.LayoutOrder, VerticalAlignment = Enum.VerticalAlignment.Center,
	}, f)
	return f
end

local function applyStyle(btn, styleName)
	local s = STYLES[styleName]
	local g = btn:FindFirstChildOfClass("UIGradient")
	g.Color = ColorSequence.new(s[1], s[2])
	btn.BackgroundTransparency = s[3]
	btn.TextColor3 = s[4]
	btn.TextStrokeColor3 = Color3.new(0, 0, 0)
	btn.TextStrokeTransparency = s[5]
end

-- opts: n = buttons in the row, h = height (when not in a row)
local function button(par, label, styleName, cb, opts)
	opts = opts or {}
	local b = make("TextButton", {
		BackgroundColor3 = WHITE, BorderSizePixel = 0, AutoButtonColor = false, Text = label,
		Font = Enum.Font.GothamBold, TextSize = 12, TextWrapped = true, LayoutOrder = nextOrder(),
		Size = opts.n and UDim2.new(1 / opts.n, -(8 * (opts.n - 1)) / opts.n, 1, 0) or UDim2.new(1, 0, 0, opts.h or 38),
	}, par)
	round(b, 11)
	make("UIGradient", { Rotation = 25 }, b)
	stroke(b, 0.8)
	local sc = make("UIScale", {}, b)
	hoverScale(b, sc)
	applyStyle(b, styleName)
	b.MouseButton1Click:Connect(function() if cb then cb() end end)
	return b
end

