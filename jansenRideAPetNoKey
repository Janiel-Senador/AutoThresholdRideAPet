local function hoverScale(btn, sc)
	btn.MouseEnter:Connect(function() tween(sc, 0.12, { Scale = 1.03 }) end)
	btn.MouseLeave:Connect(function() tween(sc, 0.12, { Scale = 1 }) end)
	btn.MouseButton1Down:Connect(function() tween(sc, 0.08, { Scale = 0.95 }) end)
	btn.MouseButton1Up:Connect(function() tween(sc, 0.14, { Scale = 1 }, Enum.EasingStyle.Back) end)
end

