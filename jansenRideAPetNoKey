	local fill = make("Frame", { Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = WHITE, BorderSizePixel = 0 }, track)
	round(fill, 4)
	make("UIGradient", { Color = ColorSequence.new(ACCENT, ACCENT2) }, fill)
