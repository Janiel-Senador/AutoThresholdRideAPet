local function applyStyle(btn, styleName)
	local s = STYLES[styleName]
	local g = btn:FindFirstChildOfClass("UIGradient")
	g.Color = ColorSequence.new(s[1], s[2])
	btn.BackgroundTransparency = s[3]
	btn.TextColor3 = s[4]
end

